{
  "manifest_version": 3,
  "name": "Copy Tab Links",
  "version": "1.0",
  "description": "Select tabs, click the icon, and copy their titles and links.",
  "permissions": ["tabs", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Copy Tab Links"
  }
}
